# ================================================================
# CCI Department Guidance System - Environment Configuration
# ================================================================
# Copy this file to .env and fill in your values
# ================================================================

# Server Configuration
PORT=3000
NODE_ENV=development  # development | production

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database Connection (Direct - Optional)
DATABASE_URL=postgresql://postgres.your-project-id:password@aws-0-region.pooler.supabase.com:6543/postgres

# CORS Configuration (Production URLs only - localhost added automatically in dev mode)
CORS_ORIGIN=https://cci-department-guidance.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info  # error | warn | info | debug

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# ================================================================
# IMPORTANT NOTES:
# ================================================================
# 
# 1. CORS_ORIGIN in production should ONLY contain production URLs
#    - Localhost URLs (http://localhost:*) are automatically allowed in development mode
#    - In production mode, only URLs in CORS_ORIGIN are allowed
#
# 2. NODE_ENV modes:
#    - development: Allows localhost + CORS_ORIGIN URLs, relaxed CSP
#    - production: Only CORS_ORIGIN URLs, strict security headers
#
# 3. Never commit .env file to Git (already in .gitignore)
#
# 4. For deployment platforms (Vercel, Railway, Render):
#    - Set all these variables in the platform's environment settings
#    - Use production values
#    - Never expose SUPABASE_SERVICE_ROLE_KEY publicly
#
# ================================================================
