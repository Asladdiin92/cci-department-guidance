# ================================================================
# CCI Department Guidance System - Sample Environment Configuration
# ================================================================
# This is a SAMPLE file. To use it:
#   1. Copy this file: cp .env.sample .env
#   2. Fill in your actual Supabase credentials below
#   3. Generate a secure JWT_SECRET
#   4. Never commit .env to git!
# ================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# CORS Configuration (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# JWT Configuration
# Generate secure secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-this
JWT_EXPIRES_IN=7d

# Security
BCRYPT_ROUNDS=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# ================================================================
# HOW TO GET SUPABASE CREDENTIALS
# ================================================================
# 1. Go to https://app.supabase.com
# 2. Select your project
# 3. Click Settings (gear icon) → API
# 4. Copy:
#    - Project URL → SUPABASE_URL
#    - anon public → SUPABASE_ANON_KEY  
#    - service_role (secret!) → SUPABASE_SERVICE_ROLE_KEY
# ================================================================

# ================================================================
# SECURITY REMINDERS
# ================================================================
# ⚠️  NEVER commit .env to version control
# ⚠️  Keep SERVICE_ROLE_KEY secret (has full database access)
# ⚠️  Use different JWT_SECRET for production
# ⚠️  Enable RLS (Row Level Security) in Supabase
# ================================================================
